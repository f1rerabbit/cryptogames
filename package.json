{
  "name": "cryptogames",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "node scripts/require-test-database.mjs && vitest run --project integration",
    "test:e2e": "playwright test",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:smoke && pnpm build && pnpm test:e2e && pnpm --filter @cg/db validate",
    "db:generate": "pnpm --filter @cg/db generate",
    "migrate": "pnpm --filter @cg/db migrate",
    "seed": "pnpm --filter @cg/db seed",
    "test:smoke": "vitest run --project smoke",
    "seed:verify-fail-closed": "./scripts/verify-production-seed.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "24.3.0",
    "eslint": "9.34.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.0"
  }
}
