generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  PLAYER
  SUPPORT
  FINANCE
  RISK
  CONTENT
  ADMIN
  AUDITOR
}

enum AccountKind {
  TEST_FUNDS
  RESERVED
  BONUS
  SYSTEM
  PLAYER_AVAILABLE
  PLATFORM_TREASURY
  GAME_ESCROW
  TEST_FAUCET
}

enum PlayerStatus {
  ACTIVE
  FROZEN
  SUSPENDED
}
enum GameSessionStatus {
  CREATED
  ACTIVE
  COMPLETED
  CANCELLED
}
enum WagerStatus {
  PENDING
  ACCEPTED
  SETTLED
  REFUNDED
  REJECTED
}
enum SettlementResult {
  LOSS
  WIN_SMALL
  WIN_LARGE
  REFUND
}

enum EntryDirection {
  DEBIT
  CREDIT
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  passwordHash String
  status       String          @default("ACTIVE")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  roles        UserRole[]
  sessions     Session[]
  consents     Consent[]
  accounts     LedgerAccount[]
  profile      PlayerProfile?
  faucetClaims DemoFaucetClaim[]
  gameSessions GameSession[]
  wagers       GameWager[]
}

model PlayerProfile {
  userId      String       @id @db.Uuid
  displayName String?
  status      PlayerStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
}

model Role {
  id    String     @id @default(uuid()) @db.Uuid
  name  RoleName   @unique
  users UserRole[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model Consent {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  documentType    String
  documentVersion String
  documentHash    String
  acceptedAt      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])

  @@unique([userId, documentType, documentVersion])
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid
  subjectId     String?  @db.Uuid
  action        String
  outcome       String
  reason        String?
  correlationId String
  metadata      Json
  createdAt     DateTime @default(now())

  @@index([correlationId])
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String
  updatedAt   DateTime @updatedAt
}

model Asset {
  code          String              @id
  name          String
  scale         Int                 @default(0)
  withdrawable  Boolean             @default(false)
  accounts      LedgerAccount[]
  transactions  LedgerTransaction[]
}

model LedgerAccount {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String?       @db.Uuid
  assetCode     String
  kind          AccountKind
  allowNegative Boolean       @default(false)
  createdAt     DateTime      @default(now())
  user          User?         @relation(fields: [userId], references: [id])
  asset         Asset         @relation(fields: [assetCode], references: [code])
  entries       LedgerEntry[]

  @@unique([userId, assetCode, kind])
}

model LedgerTransaction {
  id             String              @id @default(uuid()) @db.Uuid
  assetCode      String
  type           String
  referenceId    String?
  compensatesId  String?             @db.Uuid
  correlationId  String
  createdAt      DateTime            @default(now())
  asset          Asset               @relation(fields: [assetCode], references: [code])
  entries        LedgerEntry[]
  idempotency    IdempotencyRecord?
  compensates    LedgerTransaction?  @relation("LedgerCompensation", fields: [compensatesId], references: [id])
  compensatedBy  LedgerTransaction[] @relation("LedgerCompensation")
  wagers          GameWager[]          @relation("WagerLedger")
  settlements     GameWager[]          @relation("SettlementLedger")

  @@index([compensatesId])
}

model DemoFaucetClaim {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  idempotencyKey String
  amount         BigInt
  claimedAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([userId, claimedAt])
}

model Game {
  id           String        @id @default(uuid()) @db.Uuid
  slug         String        @unique
  name         String
  provider     String
  category     String
  description  String?
  thumbnailUrl String?
  active       Boolean       @default(true)
  demoOnly     Boolean       @default(true)
  minBet       BigInt
  maxBet       BigInt
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     GameSession[]
  wagers       GameWager[]

  @@index([active, sortOrder, id])
}

model GameSession {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  gameId      String            @db.Uuid
  status      GameSessionStatus @default(ACTIVE)
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id])
  game        Game              @relation(fields: [gameId], references: [id])
  wagers      GameWager[]

  @@index([userId, createdAt, id])
  @@index([gameId, createdAt])
}

model GameWager {
  id                            String            @id @default(uuid()) @db.Uuid
  sessionId                     String            @db.Uuid
  userId                        String            @db.Uuid
  gameId                        String            @db.Uuid
  idempotencyKey                String
  settlementKey                 String?           @unique
  stake                         BigInt
  payout                        BigInt?
  status                        WagerStatus        @default(PENDING)
  result                        SettlementResult?
  createdAt                     DateTime           @default(now())
  settledAt                     DateTime?
  ledgerTransactionId           String?            @unique @db.Uuid
  settlementLedgerTransactionId String?            @unique @db.Uuid
  session                       GameSession         @relation(fields: [sessionId], references: [id])
  user                          User                @relation(fields: [userId], references: [id])
  game                          Game                @relation(fields: [gameId], references: [id])
  ledgerTransaction             LedgerTransaction? @relation("WagerLedger", fields: [ledgerTransactionId], references: [id])
  settlementLedgerTransaction   LedgerTransaction? @relation("SettlementLedger", fields: [settlementLedgerTransactionId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([sessionId, createdAt, id])
  @@index([userId, createdAt, id])
}

model LedgerEntry {
  id            String            @id @default(uuid()) @db.Uuid
  transactionId String            @db.Uuid
  accountId     String            @db.Uuid
  direction     EntryDirection
  amount        BigInt
  createdAt     DateTime          @default(now())
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  account       LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
}

model IdempotencyRecord {
  id            String            @id @default(uuid()) @db.Uuid
  key           String
  scope         String
  requestHash   String
  transactionId String            @unique @db.Uuid
  createdAt     DateTime          @default(now())
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])

  @@unique([scope, key])
}
